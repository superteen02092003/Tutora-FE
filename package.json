{
  "name": "TUTORA",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:zalo": "vite --mode zalo",
    "build": "tsc -b && vite build && node scripts/prune-pages-dist.mjs",
    "build:zalo": "tsc -b && vite build --mode zalo && node scripts/zalo-post-build.mjs",
    "lint": "eslint .",
    "test:presence": "node --experimental-strip-types --test tests/presence.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,json}\""
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@microsoft/signalr": "^10.0.0",
    "@netless/fastboard": "^1.1.8",
    "@supabase/supabase-js": "^2.90.0",
    "@types/katex": "^0.16.8",
    "agora-rtc-sdk-ng": "^4.24.5",
    "agora-rtm-sdk": "^2.2.4",
    "antd": "^6.1.4",
    "axios": "^1.19.0",
    "date-fns": "^4.1.0",
    "katex": "^0.18.4",
    "lucide-react": "^0.562.0",
    "ogl": "^1.0.11",
    "onnxruntime-web": "^1.27.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^5.5.7",
    "react-grid-layout": "^2.2.4",
    "react-infinite-scroll-component": "^6.1.1",
    "react-markdown": "^10.1.0",
    "react-resizable": "^4.0.2",
    "react-router-dom": "^7.12.0",
    "react-toastify": "^11.0.5",
    "recharts": "^3.7.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zmp-sdk": "^2.51.1",
    "zmp-vite-plugin": "^1.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^5.4.20"
  },
  "overrides": {
    "agora-rtm-sdk": {
      "agora-rtc-sdk-ng": "$agora-rtc-sdk-ng"
    }
  }
}
